# Copy this file to .env for local development.
# Add the same variables in Vercel: Project -> Settings -> Environment Variables.

# OpenRouter API key (used by /api/chat)
MY_SECRET_API_KEY=your_openrouter_api_key_here

# Tavily API key (used by /api/search for GK mode)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: shows up in OpenRouter's app attribution headers
PUBLIC_SITE_URL=https://your-project.vercel.app
